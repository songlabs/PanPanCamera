            "value": "版本 0.1"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 0.1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 0.1"
          }
        }
      }
    },
    "settings.scope.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の撮影と結果プレビューに対応しています。美肌・顔補正はパラメータ調整のみ、メイクとフィルターは選択画面のみです。ビデオ、ポートレート、アルバム、比率変更、タイマーは未対応です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持拍照和结果预览。美肌与美型仅提供参数调整，美妆与滤镜仅提供选择界面。暂不支持视频、人像、相册、画幅更改或定时拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援拍照與結果預覽。美肌與美型僅提供參數調整，美妝與濾鏡僅提供選擇介面。尚未支援影片、人像、相簿、比例變更或計時拍攝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo capture and result preview are implemented. Skin and reshape provide parameter controls; makeup and filters provide selection screens. Video, portrait, album, ratio changes, and timer capture are unavailable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 촬영과 결과 미리보기를 지원해요. 피부 및 얼굴 보정은 설정값 조절만, 메이크업과 필터는 선택 화면만 제공해요. 동영상, 인물 모드, 앨범, 비율 변경, 타이머 촬영은 아직 지원하지 않아요."
          }
        }
      }
    },

        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "唇の質感と陰影を保ち、自然な血色を加えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自然调整唇部颜色，保留纹理和明暗层次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自然調整唇部顏色，保留紋理和明暗層次。"

    "permission.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューと撮影を使うには、設定でPanPanのカメラへのアクセスを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中允许 PanPan 访问相机，以使用实时预览和拍照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中允許 PanPan 存取相機，以使用即時預覽與拍照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow PanPan to access the camera in Settings to use live preview and take photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 미리보기와 사진 촬영을 사용하려면 설정에서 PanPan의 카메라 접근을 허용해 주세요."
          }
        }
      }
    },

    "album.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムの読み込みと保存は未実装です。このバージョンは写真ライブラリへのアクセスを要求しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相册导入和保存尚未实现。当前版本不会请求照片图库权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿匯入與儲存尚未實作。目前版本不會要求照片圖庫權限。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Album import and saving are not implemented yet. This version does not request photo library access."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 불러오기와 저장은 아직 지원하지 않아요. 현재 버전은 사진 보관함 접근 권한을 요청하지 않아요."
          }
        }
      }
    },

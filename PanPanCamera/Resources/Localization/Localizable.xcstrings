      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマー撮影は未実装です。シャッターを押すとすぐに撮影します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时拍摄尚未实现，点击快门会立即拍照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時拍攝尚未實作，點選快門會立即拍照。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The timer is not implemented yet. The shutter takes a photo immediately."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머 촬영은 아직 지원하지 않아요. 셔터를 누르면 바로 촬영해요."
          }
        }
      }
    },

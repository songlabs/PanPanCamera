    "settings.privacy.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とカメラの処理はデバイス内で完結します。写真のアップロード、外部AI API、アカウント、広告、解析SDKは使用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片和相机处理均在设备本地完成。不上传照片，不使用外部 AI API、账号、广告或分析 SDK。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片與相機處理均在裝置本機完成。不上傳照片，不使用外部 AI API、帳號、廣告或分析 SDK。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos and camera processing stay on your device. No photo uploads, external AI APIs, accounts, ads, or analytics SDKs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 카메라 처리는 모두 기기에서 이루어져요. 사진 업로드, 외부 AI API, 계정, 광고, 분석 SDK를 사용하지 않아요."
          }
        }
      }
    },
    "settings.scope": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン0.1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 0.1"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "版本 0.1"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version 0.1"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 0.1"
          }
        }
      }
    },
    "settings.scope.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真撮影、結果プレビュー、美肌・メイク・フィルターのリアルタイム表示と写真への適用に対応しています。小顔・顔幅・あご・おでこ・頬骨の補正はリアルタイム表示のみです。目・鼻・口の形状補正、ビデオ、ポートレート、アルバム、比率変更、タイマーは未対応です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持拍照、结果预览，以及美肌、美妆和滤镜的实时预览与照片处理。小脸、脸宽、下巴、额头和颧骨调整仅用于实时预览。暂不支持眼、鼻、嘴的形状调整，以及视频、人像、相册、画幅更改或定时拍摄。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援拍照、結果預覽，以及美肌、美妝和濾鏡的即時預覽與相片處理。小臉、臉寬、下巴、額頭和顴骨調整僅用於即時預覽。尚未支援眼、鼻、嘴的形狀調整，以及影片、人像、相簿、比例變更或計時拍攝。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photo capture, result preview, and live/final skin, makeup, and filter processing are implemented. Slim, face width, chin, forehead, and cheekbone adjustments apply to live preview only. Eye, nose, and mouth reshaping, video, portrait, album, ratio changes, and timer capture are unavailable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 촬영, 결과 미리보기, 피부 보정·메이크업·필터의 실시간 미리보기와 사진 적용을 지원해요. 작은 얼굴, 얼굴 너비, 턱, 이마, 광대뼈 조정은 실시간 미리보기에만 적용돼요. 눈·코·입 형태 보정, 동영상, 인물 모드, 앨범, 비율 변경, 타이머 촬영은 아직 지원하지 않아요."
          }
        }
      }
    },

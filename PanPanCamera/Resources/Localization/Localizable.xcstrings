    "makeup.blush.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頬にやわらかな血色を加え、自然になじませます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为双颊增加柔和气色，让边缘自然融入肤色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為雙頰增加柔和氣色，讓邊緣自然融入膚色。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a soft flush to the cheeks with gently blended edges."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양 볼에 은은한 생기를 더하고 경계를 부드럽게 표현합니다."
          }
        }
      }
    },
    "makeup.brow": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイブロウ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眉妆"

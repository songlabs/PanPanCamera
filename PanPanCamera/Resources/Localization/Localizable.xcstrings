    "beauty.skin.overallDetail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各項目をまとめて設定し、美肌全体の強さを調整。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量设置各项，并控制美肤整体强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次設定各項，並控制美膚整體強度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set all skin controls together and scale their overall effect."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 피부 항목을 함께 설정하고 전체 강도를 조절합니다."
          }
        }
      }
    },
    "beauty.skin.overallRange": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",

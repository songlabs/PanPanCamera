        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈썹"
          }
        }
      }
    },
    "makeup.brow.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眉の形と毛の質感を保ち、色を少し深めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻量加深眉部颜色，保留原有眉形和毛发纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕量加深眉部顏色，保留原有眉形和毛髮紋理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently deepen brow color while preserving shape and texture."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본래 눈썹 모양과 결을 살리며 색을 조금 진하게 합니다."
          }
        }
      }
    },
    "makeup.eye": {
      "extractionState": "manual",
      "localizations": {

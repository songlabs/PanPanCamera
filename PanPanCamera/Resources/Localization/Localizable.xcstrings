    "beauty.face.overallDetail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5つの顔補正の強さを一括調整 · プレビューのみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "统一调节五项美型强度 · 仅预览"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "統一調節五項美型強度 · 僅預覽"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scale all five reshape effects · Preview only"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다섯 가지 얼굴 보정 강도 조절 · 미리보기만"
          }
        }
      }
    },
    "beauty.face.overallRange": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 補正なし · 100% 各項目の設定どおりの強さ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 不调整 · 100% 按各项设定全强度应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 不調整 · 100% 按各項設定全強度套用"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0% off · 100% full strength at each setting"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0% 보정 없음 · 100% 각 항목의 설정 강도 그대로"
          }
        }
      }
    },
    "beauty.face.strengthRange": {
      "extractionState": "manual",

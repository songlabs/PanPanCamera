    "makeup.eye.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目の輪郭に沿って、目元を控えめに引き立てます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿眼部轮廓轻量增强眼周，保留自然眼神。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沿眼部輪廓輕量增強眼周，保留自然眼神。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gently enhance the eye area along its natural contours."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈의 자연스러운 윤곽을 따라 눈 주변을 은은하게 강조합니다."
          }
        }
      }
    },

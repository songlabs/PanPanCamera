    "skin.blemish.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質感を残し、赤みのある小さなニキビ跡を和らげます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "局部弱化偏红的小痘印，保留肌肤纹理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "局部弱化偏紅的小痘印，保留肌膚紋理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soften small reddish blemishes while retaining texture."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피부 질감을 유지하며 작고 붉은 여드름 자국을 완화합니다."
          }
        }
      }
    },

    "camera.aspectRatio": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の比率"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画幅比例"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片比例"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspect ratio"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 비율"
          }
        }
      }
    },
    "camera.aspectRatio.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比率の変更は未実装です。写真はカメラ標準の比率で撮影します。全画面プレビューでは写真の周辺が一部表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持更改画幅。照片使用相机原生比例，全屏预览会裁去部分边缘，拍摄结果保留完整画面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未支援變更比例。照片使用相機原生比例，全螢幕預覽會裁去部分邊緣，拍攝結果保留完整畫面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ratio controls are not implemented yet. Photos use the native camera ratio. The full-screen preview crops some edges; the photo keeps the full frame."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비율 변경은 아직 지원하지 않아요. 사진은 카메라 기본 비율로 촬영돼요. 전체 화면 미리보기에서는 가장자리 일부가 잘리지만 사진에는 전체 화면이 담겨요."
          }
        }
      }
    },
    "camera.back": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアカメラ"

    "filter.clear.detail": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るさを少し上げ、重い色味をやわらげます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "略微提亮并减轻过重色彩，让画面更清透。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "略微提亮並減輕過重色彩，讓畫面更清透。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift brightness and soften heavy colors for a clearer look."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "밝기를 조금 높이고 짙은 색감을 부드럽게 조정합니다."
          }
        }
      }

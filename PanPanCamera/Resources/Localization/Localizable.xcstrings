    "permission.restricted": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラの利用が制限されています。スクリーンタイムやデバイスの管理設定をご確認ください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备限制了相机使用，请检查屏幕使用时间或设备管理设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置限制了相機使用，請檢查螢幕使用時間或裝置管理設定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is restricted on this device. Check Screen Time or device management settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 카메라 사용이 제한되어 있어요. 스크린 타임이나 기기 관리 설정을 확인해 주세요."
          }
        }
      }
    },

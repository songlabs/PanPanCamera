    "feature.previewOnly": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメータ調整のみ対応しています。美肌・顔補正の効果は、プレビューにも撮影した写真にも適用されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前仅支持参数调整，美肌和美型效果不会应用于预览或拍摄的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前僅支援參數調整，美肌與美型效果不會套用至預覽或拍攝的照片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Parameter controls only. Skin and face effects are not applied to the preview or captured photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 설정값만 조절할 수 있어요. 피부 및 얼굴 보정 효과는 미리보기와 촬영한 사진에 적용되지 않아요."
          }
        }
      }
    },

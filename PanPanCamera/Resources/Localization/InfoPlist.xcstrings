    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のプレビューと撮影のためにカメラを使用します。写真はデバイス内で処理され、アップロードされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机进行实时预览和拍照。照片仅在设备本地处理，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機進行即時預覽與拍照。照片僅在裝置本機處理，不會上傳。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PanPan uses the camera for live preview and photos. Photos are processed on your device and are not uploaded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 미리보기와 사진 촬영을 위해 카메라를 사용해요. 사진은 기기에서만 처리되며 업로드되지 않아요."
          }
        }
      }
    }
  },
  "version": "1.0"
}
